# Copy to .env and fill in, OR point GFEM_ENV_FILE at wherever these already live
# (e.g. the gfem-data checkout's own .env already has them, and gfem picks that up
# automatically for an editable install -- you likely don't need this file at all).
#
# Names matter: gfem.env reads exactly these four for auth, and APX_ENV for host
# selection. APX_MODE / APX_CLIENT_SECRET (seen in some older configs) are NOT read.
APX_CLIENT_ID=
APX_SECRET=
APX_USERNAME=
APX_PASSWORD=
APX_ENV=prod

# This tool's own knobs.
APX_MARKET_PARTICIPANT=QGFEN
APX_CURVE_WATCH_RESOURCES=
APX_CURVE_WATCH_POLL_SECONDS=30
APX_CURVE_WATCH_STORAGE_DIR=./curves

# Optional. Leave unset and change announcements stay console + log only.
TEAMS_WEBHOOK_URL=

# Wall-clock times (Central) to check that tomorrow's energy book has something
# on file, and nudge if not. Comma-separated; each entry is either a single time
# ("08:00", fires once) or a window with a cadence ("08:30-09:00:15" = every 15
# min from 08:30 through 09:00 inclusive). Empty disables the check.
APX_CURVE_WATCH_NEXT_DAY_CHECK_TIMES=08:30-09:00:15,09:00-09:30:10,09:30-10:00:5
