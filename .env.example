# Copy to .env and fill in, OR point GFEM_ENV_FILE at wherever these already live
# (e.g. the gfem-data checkout's own .env already has them, and gfem picks that up
# automatically for an editable install -- you likely don't need this file at all).
#
# Names matter: gfem.env reads exactly these four for auth, and APX_ENV for host
# selection. APX_MODE / APX_CLIENT_SECRET (seen in some older configs) are NOT read.
APX_CLIENT_ID=
APX_SECRET=
APX_USERNAME=
APX_PASSWORD=
APX_ENV=prod

# This tool's own knobs.
APX_MARKET_PARTICIPANT=QGFEN
APX_CURVE_WATCH_RESOURCES=
APX_CURVE_WATCH_POLL_SECONDS=30
APX_CURVE_WATCH_STORAGE_DIR=./curves
APX_CURVE_WATCH_LOG_FILE=apx-curve-watch.log

# Optional. Leave unset and change announcements stay console + log only.
TEAMS_WEBHOOK_URL=

# Wall-clock times (Central) to check that tomorrow's energy book has something
# on file, and nudge if not. Comma-separated; each entry is either a single time
# ("08:00", fires once) or a window with a cadence ("08:30-09:00:15" = every 15
# min from 08:30 through 09:00 inclusive). Empty disables the check.
APX_CURVE_WATCH_NEXT_DAY_CHECK_TIMES=08:30-09:00:15,09:00-09:30:10,09:30-10:00:5

# Day-ahead reasonability rules, checked against TOMORROW's book at the times
# above. Each is a desk parameter, so it's a knob rather than a constant in the
# rule. A book that passes every rule announces nothing.
#
# Hour-endings that must carry the charge block, and how much charge the site
# (every watched resource, every hour in the block, summed) has to bid across
# them in MWh.
APX_CURVE_WATCH_CHARGE_BLOCK_HOURS=9-13
APX_CURVE_WATCH_CHARGE_BLOCK_MWH=1000
# In any hour offering BOTH discharge energy and an AS product, the energy
# ladder must reach this MW per resource -- otherwise the optimizer reads the
# ESR as capped at whatever the ladder tops out at and won't stack AS on top.
APX_CURVE_WATCH_MIN_DISCHARGE_MW=200
# Flag a day that bids no discharge at all, anywhere -- a book someone stopped
# building halfway passes every other rule, since the rules about discharge
# hours have no discharge hours to test.
APX_CURVE_WATCH_CHECK_DISCHARGE_PRESENT=true
# Flag hours where the ESRs' energy ladders differ (they're bid as one site).
APX_CURVE_WATCH_CHECK_ESR_SYMMETRY=true
